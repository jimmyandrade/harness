{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for the core harness and every business harness.",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 9am on monday"],
  "dependencyDashboardTitle": "chore(deps): dependency dashboard",
  "packageRules": [
    {
      "description": "A major update waits for approval on the Dependency Dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Move every pin of the core harness in one pull request, as soon as a release exists.",
      "matchPackageNames": ["jimmyandrade/harness"],
      "groupName": "harness core",
      "schedule": ["at any time"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "The npm dependency on the core harness is named harness in package.json.",
      "matchDepNames": ["harness"],
      "matchDatasources": ["github-tags"],
      "groupName": "harness core",
      "schedule": ["at any time"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Move every pin of the vocabulary package in one pull request, as soon as a release exists.",
      "matchPackageNames": ["jimmyandrade/vocabulary"],
      "groupName": "vocabulary",
      "schedule": ["at any time"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "The npm dependency on the vocabulary package is named vocabulary in package.json.",
      "matchDepNames": ["vocabulary"],
      "matchDatasources": ["github-tags"],
      "groupName": "vocabulary",
      "schedule": ["at any time"],
      "dependencyDashboardApproval": false
    }
  ],
  "customManagers": [
    {
      "description": "Plugin sources pinned in a Claude Code marketplace or in the Claude Code project settings.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|\/)\\.claude-plugin\/marketplace\\.json$/", "/(^|\/)\\.claude\/settings\\.json$/"],
      "matchStrings": [
        "\"source\":\\s*\"github\",\\s*\"repo\":\\s*\"(?<depName>[^\"]+)\",\\s*\"ref\":\\s*\"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
