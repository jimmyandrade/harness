{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for the core harness and every business harness.",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 9am on monday"],
  "dependencyDashboardTitle": "chore(deps): dependency dashboard",
  "packageRules": [
    {
      "description": "A major update waits for approval on the Dependency Dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Move every pin of the core harness and of the vocabulary package in one pull request, as soon as a release exists.",
      "matchPackageNames": ["jimmyandrade/harness", "jimmyandrade/vocabulary"],
      "groupName": "core harness and vocabulary",
      "schedule": ["at any time"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "The npm dependencies on the core harness and on the vocabulary package are named harness and vocabulary in package.json.",
      "matchDepNames": ["harness", "vocabulary"],
      "matchDatasources": ["github-tags"],
      "groupName": "core harness and vocabulary",
      "schedule": ["at any time"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "A minor or patch release of the core harness or the vocabulary package merges by itself once the checks of the pull request pass.",
      "matchPackageNames": ["jimmyandrade/harness", "jimmyandrade/vocabulary", "harness", "vocabulary"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "description": "Plugin sources pinned in a Claude Code marketplace, which Codex also reads, or in the Claude Code project settings.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|\/)\\.claude-plugin\/marketplace\\.json$/", "/(^|\/)\\.claude\/settings\\.json$/"],
      "matchStrings": [
        "\"source\":\\s*\"github\",\\s*\"repo\":\\s*\"(?<depName>[^\"]+)\",\\s*\"ref\":\\s*\"(?<currentValue>v[^\"]+)\"",
        "\"source\":\\s*\"url\",\\s*\"url\":\\s*\"https://github\\.com/(?<depName>[^\"]+)\\.git\",\\s*\"ref\":\\s*\"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
