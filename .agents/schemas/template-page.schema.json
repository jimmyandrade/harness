{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-page",
  "title": "Model page",
  "description": "A model in .agents/assets/templates, published as one page of the models database (ADR 0012). The mapping binds name and version; the other fields are written only when it binds them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "version", "body"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "body": {
      "type": "string",
      "minLength": 1
    }
  }
}
