{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-page",
  "title": "Skill page",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "version", "body"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "body": {
      "type": "string",
      "minLength": 1
    }
  }
}
